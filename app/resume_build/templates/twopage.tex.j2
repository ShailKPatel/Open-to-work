\documentclass[\VAR{layout.font_pt}pt, letterpaper]{\VAR{layout.doc_class}}

% Preamble is RenderCV's own template styling (github.com/rendercv/rendercv,
% MIT licensed) - structural LaTeX only, no personal data. Every actual
% resume value below is a Jinja placeholder filled in by
% app/resume_build/context.py + app/resume_build/latex.py, never hardcoded
% here.
%
% Only real difference from onepage.tex.j2: geometry/spacing constants
% below are looser (a two-page resume doesn't need to fight for every
% millimeter the way a one-page one does), and \pagestyle prints a page
% number in the footer since a two-page document actually needs one.
% Section/entry structure is otherwise identical, so app/resume_build/
% context.py and orchestrator.py's data shape works unchanged against
% either template.

% Packages:
\usepackage[
    top=\VAR{layout.margin_top_cm} cm,
    bottom=\VAR{layout.margin_bottom_cm} cm,
    left=\VAR{layout.margin_side_cm} cm,
    right=\VAR{layout.margin_side_cm} cm,
    footskip=\VAR{layout.footskip_cm} cm,
]{geometry}
\usepackage{titlesec}
\usepackage{tabularx}
\usepackage{array}
\usepackage[dvipsnames]{xcolor}
\definecolor{primaryColor}{RGB}{0, 79, 144}
\usepackage{enumitem}
\usepackage{fontawesome5}
\usepackage{amsmath}
\usepackage[
    pdftitle={\VAR{full_name | latex} - Resume},
    pdfauthor={\VAR{full_name | latex}},
    pdfcreator={LaTeX},
    colorlinks=true,
    urlcolor=black,
    linkcolor=primaryColor
]{hyperref}
\usepackage[pscoord]{eso-pic}
\usepackage{calc}
\usepackage{bookmark}
\usepackage{lastpage}
\usepackage{changepage}
\usepackage{paracol}
\usepackage{ifthen}
\usepackage{needspace}
\usepackage{iftex}
\usepackage{graphicx}

\ifPDFTeX
    \input{glyphtounicode}
    \pdfgentounicode=1
    \usepackage[utf8]{inputenc}
    \usepackage{lmodern}
\fi

\AtBeginEnvironment{adjustwidth}{\partopsep0pt}
\setcounter{secnumdepth}{0}
\setlength{\parindent}{0pt}
\setlength{\topskip}{0pt}
\setlength{\columnsep}{0cm}
\makeatletter
\def\ps@customFooterStyle{%
    \renewcommand{\@oddfoot}{\hfil\footnotesize\thepage\ of \pageref{LastPage}\hfil}
    \renewcommand{\@evenfoot}{\hfil\footnotesize\thepage\ of \pageref{LastPage}\hfil}
    \renewcommand{\@oddhead}{}
    \renewcommand{\@evenhead}{}
}
\makeatother
\pagestyle{customFooterStyle}

\titleformat{\section}{\needspace{4\baselineskip}\bfseries\large}{}{0pt}{}[\vspace{1pt}\titlerule]

\titlespacing{\section}{-1pt}{\VAR{layout.section_before_cm} cm}{\VAR{layout.section_after_cm} cm}

\renewcommand\labelitemi{$\circ$}
\newenvironment{highlights}{
    \begin{itemize}[
        topsep=\VAR{layout.bullet_topsep_cm} cm,
        parsep=\VAR{layout.bullet_parsep_cm} cm,
        partopsep=0pt,
        itemsep=0pt,
        leftmargin=0.4 cm + 10pt
    ]
}{
    \end{itemize}
}

\newenvironment{onecolentry}{
    \begin{adjustwidth}{0.2 cm + 0.00001 cm}{0.2 cm + 0.00001 cm}
}{
    \end{adjustwidth}
}

\newenvironment{twocolentry}[2][]{
    \onecolentry
    \def\secondColumn{#2}
    \setcolumnwidth{\fill, 4.5 cm}
    \begin{paracol}{2}
}{
    \switchcolumn \raggedleft \secondColumn
    \end{paracol}
    \endonecolentry
}

\newenvironment{header}{
    \setlength{\topsep}{0pt}\par\kern\topsep\centering\linespread{1.5}
}{
    \par\kern\topsep
}

\let\hrefWithoutArrow\href

\linespread{\VAR{layout.line_spread}}

\begin{document}

    \begin{header}
        \textbf{\fontsize{\VAR{layout.name_pt} pt}{\VAR{layout.name_pt} pt}\selectfont \VAR{full_name | latex}}
        \vspace{\VAR{layout.header_gap_cm} cm}

        \normalsize
        {\color{black}
        \BLOCK{for item in contact_items}
        \BLOCK{if item.href}\mbox{\hrefWithoutArrow{\VAR{item.href | latex_url}}{\VAR{item.icon}\ \VAR{item.text | latex}}}\BLOCK{else}\mbox{\VAR{item.icon}\ \VAR{item.text | latex}}\BLOCK{endif}%
        \BLOCK{if not loop.last}\kern 0.20 cm\textbar\kern 0.20 cm\BLOCK{endif}
        \BLOCK{endfor}
        }

        \BLOCK{if social_items}
        \vspace{0.05 cm}

        {\color{black}
        \BLOCK{for item in social_items}
        \BLOCK{if item.href}\mbox{\hrefWithoutArrow{\VAR{item.href | latex_url}}{\VAR{item.icon}\ \VAR{item.text | latex}}}\BLOCK{else}\mbox{\VAR{item.icon}\ \VAR{item.text | latex}}\BLOCK{endif}%
        \BLOCK{if not loop.last}\kern 0.20 cm\textbar\kern 0.20 cm\BLOCK{endif}
        \BLOCK{endfor}
        }
        \BLOCK{endif}

    \end{header}

\vspace{0.3 cm - 0.3 cm}

\BLOCK{if summary}
\section{Summary}
\begin{onecolentry}
    \VAR{summary | latex}
\end{onecolentry}
\BLOCK{endif}

\BLOCK{if experience}
\section{Experience}
\BLOCK{for role in experience}
    \begin{twocolentry}{
        \BLOCK{if role.location}\textit{\VAR{role.location | latex}} \\\BLOCK{endif}
        \textit{\VAR{role.date_range | latex}}
    }
        \textbf{\VAR{role.title | latex}} \\
        \textit{\VAR{role.company | latex}}
    \end{twocolentry}

    \BLOCK{if role.points}
    \vspace{\VAR{layout.entry_gap_cm} cm}
    \begin{onecolentry}
        \begin{highlights}
            \BLOCK{for point in role.points}
            \item \VAR{point | latex}
            \BLOCK{endfor}
        \end{highlights}
    \end{onecolentry}
    \BLOCK{endif}

    \BLOCK{if not loop.last}\vspace{\VAR{layout.role_gap_cm} cm}\BLOCK{endif}
\BLOCK{endfor}
\BLOCK{endif}

\BLOCK{if projects}
\section{Projects}
\BLOCK{for project in projects}
\begin{twocolentry}{
    \textit{\VAR{project.date_range | latex}}
}
    \textbf{\VAR{project.name | latex}}\BLOCK{if project.tagline} -- \VAR{project.tagline | latex}\BLOCK{endif} \\
    \BLOCK{if project.href}\href{\VAR{project.href | latex_url}}{\VAR{project.url_display | latex}}\BLOCK{endif}
\end{twocolentry}

\BLOCK{if project.points}
\vspace{\VAR{layout.entry_gap_cm} cm}
\begin{onecolentry}
    \begin{highlights}
        \BLOCK{for point in project.points}
        \item \VAR{point | latex}
        \BLOCK{endfor}
    \end{highlights}
\end{onecolentry}
\BLOCK{endif}
\BLOCK{if project.note}
\vspace{0.05cm}
{\small \VAR{project.note | latex}}
\BLOCK{endif}

\BLOCK{if not loop.last}\vspace{\VAR{layout.project_gap_cm} cm}\BLOCK{endif}
\BLOCK{endfor}
\BLOCK{endif}

\BLOCK{if education}
\section{Education}
\BLOCK{for school in education}
    \begin{twocolentry}{
        \textit{\VAR{school.date_range | latex}}
    }
        \textbf{\VAR{school.institution | latex}} \\
        \textit{\VAR{school.degree | latex}}\BLOCK{if school.grade}\kern 0.20 cm\textbar\kern 0.20 cm \VAR{school.grade | latex}\BLOCK{endif}
    \end{twocolentry}

    \BLOCK{if school.details}
    \vspace{\VAR{layout.entry_gap_cm} cm}
    \begin{onecolentry}
        \begin{highlights}
            \BLOCK{for line in school.details}
            \item \VAR{line | latex}
            \BLOCK{endfor}
        \end{highlights}
    \end{onecolentry}
    \BLOCK{endif}
    \BLOCK{if not loop.last}\vspace{\VAR{layout.education_gap_cm} cm}\BLOCK{endif}
\BLOCK{endfor}
\BLOCK{endif}

\BLOCK{if technologies}
\section{Technologies}
\begin{onecolentry}
    \VAR{technologies | join(', ') | latex}
\end{onecolentry}
\BLOCK{endif}

\BLOCK{if skills}
\section{Skills}
\begin{onecolentry}
    \VAR{skills | join(', ') | latex}
\end{onecolentry}
\BLOCK{endif}

\end{document}
