# Optional. Raises GitHub's rate limit from 60/hr to 5,000/hr; public repo
# data reads fine without auth. The GitHub username is a per-sync input
# (the web form, or `make ingest ACCOUNT=someuser`), not deployment config.
GITHUB_TOKEN=
DATABASE_URL=sqlite:///./data/open_to_work.db

# Resume upload storage: local disk, per-account subfolder.
RESUME_STORAGE_DIR=./data/resumes

# LLM models, routed through LiteLLM as "<provider>/<model>". Any provider
# listed on the app's /apis page works; add a key for it there and point
# these two settings at its models. API keys never go in this file: they
# are entered in the app (first-run setup, or /apis) and stored encrypted
# in the database (app/core/api_keys_store.py).
#
# APP_SECRET_KEY: optional. Encrypts every stored API key at rest. Leave
# unset and one is generated automatically into data/.secret_key (0600
# permissions); set this only if you need to pin/rotate it yourself.
# APP_SECRET_KEY=
LLM_BULK_MODEL=openai/gpt-4o-mini
LLM_QUALITY_MODEL=openai/gpt-4o
MONTHLY_BUDGET_USD=20.0

# Embeddings: local sentence-transformers, no key needed
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Qdrant: service name "qdrant" when run via docker-compose, localhost otherwise
QDRANT_URL=http://localhost:6333
